# ── Mapa (MapTiler, gratis y sin tarjeta) ─────────────────
# https://cloud.maptiler.com/account/keys/  → copia tu "Default key"
NEXT_PUBLIC_MAPTILER_KEY=

# ── Pin personalizado (opcional) ─────────────────────────────
# Coloca tu PNG en /public (ej. /public/pin.png) y apunta aquí.
# Si se deja vacío, SPOTZ usa su pin SVG con sprocket integrado.
NEXT_PUBLIC_PIN_IMAGE_URL=

# ── Supabase (solo servidor, nunca expuestas al navegador) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=spot-photos

# ── Admin ───────────────────────────────────────────────────
# Contraseña larga (mín. 12 caracteres)
ADMIN_PASSWORD=
# Secreto aleatorio para firmar la sesión: openssl rand -hex 32
ADMIN_SESSION_SECRET=
